{% set s = site.social %}
{% set showLinkedin = s.linkedin and s.linkedin != "#" %}
{% set showInstagram = s.instagram and s.instagram != "#" %}
{% set showFacebook = s.facebook and s.facebook != "#" %}
{% set showX = s.x and s.x != "#" %}
{% if showLinkedin or showInstagram or showFacebook or showX %}
<div class="social-row">
  {% if showLinkedin %}<a class="social-icon" href="{{ s.linkedin }}" target="_blank" rel="noopener" aria-label="{{ site.siteName }} on LinkedIn"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg></a>{% endif %}
  {% if showInstagram %}<a class="social-icon" href="{{ s.instagram }}" target="_blank" rel="noopener" aria-label="{{ site.siteName }} on Instagram"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg></a>{% endif %}
  {% if showFacebook %}<a class="social-icon" href="{{ s.facebook }}" target="_blank" rel="noopener" aria-label="{{ site.siteName }} on Facebook"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg></a>{% endif %}
  {% if showX %}<a class="social-icon" href="{{ s.x }}" target="_blank" rel="noopener" aria-label="{{ site.siteName }} on X"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg></a>{% endif %}
</div>
{% endif %}
