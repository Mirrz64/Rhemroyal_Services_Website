<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{{ title }} | {{ site.siteName }}</title>
<meta name="description" content="{{ description }}" />
<link rel="canonical" href="{{ site.siteUrl }}{{ page.url }}" />

<meta property="og:type" content="website" />
<meta property="og:title" content="{{ title }} | {{ site.siteName }}" />
<meta property="og:description" content="{{ description }}" />
<meta property="og:image" content="{{ site.siteUrl }}/assets/og-image.jpg" />
<meta property="og:url" content="{{ site.siteUrl }}{{ page.url }}" />
<meta name="twitter:card" content="summary_large_image" />

<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon-16x16.png" />
<link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/styles.css" />

{% if navActive == 'home' %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": "{{ site.siteName }}",
  "description": "Social development & business consultancy supporting startups, emerging organisations and growing businesses.",
  "url": "{{ site.siteUrl }}/",
  "email": "{{ site.email }}",
  "areaServed": "United Kingdom"
}
</script>
{% endif %}

<script>
  window.RHEMROYAL_SETTINGS = {
    whatsappNumber: {{ site.whatsappNumber | dump | safe }},
    whatsappMessage: {{ site.whatsappMessage | dump | safe }},
    contactFormEndpoint: {{ site.contactFormEndpoint | dump | safe }},
    newsletterFormEndpoint: {{ site.newsletterFormEndpoint | dump | safe }}
  };
</script>
</head>
<body>
<a href="#main" class="skip-link">Skip to main content</a>
<div class="announce-bar">{{ site.announcementText }} <a href="/contact.html">{{ site.announcementLinkText }}</a></div>

<header class="site-header">
  <div class="container nav-wrap">
    <a class="brand" href="/index.html" aria-label="{{ site.siteName }} home">
      <picture>
        <source srcset="/assets/rhemroyal-logo.webp" type="image/webp">
        <img src="/assets/rhemroyal-logo.png" alt="{{ site.siteName }}" width="220" height="153" />
      </picture>
    </a>
    <button class="menu-btn" aria-label="Open navigation" aria-expanded="false">☰</button>
    <nav class="nav" id="nav">
      <div class="nav-links">
        <a href="/index.html" {% if navActive == 'home' %}class="active"{% endif %}>Home</a>
        <a href="/about.html" {% if navActive == 'about' %}class="active"{% endif %}>About</a>
        <a href="/services.html" {% if navActive == 'services' %}class="active"{% endif %}>Services</a>
        <a href="/programmes.html" {% if navActive == 'programmes' %}class="active"{% endif %}>Programmes</a>
        <a href="/who-we-help.html" {% if navActive == 'who' %}class="active"{% endif %}>Who We Help</a>
        <a href="/resources.html" {% if navActive == 'resources' %}class="active"{% endif %}>Resources</a>
        <a href="/case-studies.html" {% if navActive == 'case' %}class="active"{% endif %}>Case Studies</a>
        <a href="/blog.html" {% if navActive == 'blog' %}class="active"{% endif %}>Blog</a>
        <a href="/contact.html" {% if navActive == 'contact' %}class="active"{% endif %}>Contact</a>
      </div>
      <a href="/contact.html#book" class="nav-cta">Book a Consultation</a>
    </nav>
  </div>
</header>

<main id="main">
{{ content | safe }}
</main>

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <strong>{{ site.siteName | upper }}</strong>
        <p>Social development & business consultancy helping founders and emerging organisations move from idea to sustainable impact.</p>
        <div class="social-row">
          <a class="social-icon" href="{{ site.social.linkedin }}" target="_blank" rel="noopener" aria-label="{{ site.siteName }} on LinkedIn">in</a>
          <a class="social-icon" href="{{ site.social.instagram }}" target="_blank" rel="noopener" aria-label="{{ site.siteName }} on Instagram">IG</a>
          <a class="social-icon" href="{{ site.social.facebook }}" target="_blank" rel="noopener" aria-label="{{ site.siteName }} on Facebook">FB</a>
          <a class="social-icon" href="{{ site.social.x }}" target="_blank" rel="noopener" aria-label="{{ site.siteName }} on X">X</a>
        </div>
      </div>
      <div class="footer-col">
        <h4>Explore</h4>
        <ul>
          <li><a href="/about.html">About Us</a></li>
          <li><a href="/services.html">Services</a></li>
          <li><a href="/programmes.html">Programmes</a></li>
          <li><a href="/who-we-help.html">Who We Help</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Resources</h4>
        <ul>
          <li><a href="/resources.html">Templates & Guides</a></li>
          <li><a href="/case-studies.html">Case Studies</a></li>
          <li><a href="/blog.html">Blog</a></li>
          <li><a href="/contact.html">Contact</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>Contact</h4>
        <ul>
          <li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
          <li><a href="tel:{{ site.phoneLink }}">{{ site.phoneDisplay }}</a></li>
          <li>{{ site.location }}</li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p>© <span data-year></span> {{ site.siteName }}. All rights reserved.</p>
      <div class="legal-links">
        <a href="/privacy-policy.html">Privacy Policy</a>
        <a href="/terms-of-service.html">Terms of Service</a>
        <a href="/cookie-policy.html">Cookie Policy</a>
      </div>
    </div>
  </div>
</footer>

<a href="#" class="whatsapp-float" data-whatsapp-link aria-label="Chat with us on WhatsApp" target="_blank" rel="noopener">
  <svg viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><path d="M16.01 3C9.38 3 4 8.38 4 15.01c0 2.38.7 4.6 1.9 6.47L4 29l7.72-1.86a11.9 11.9 0 0 0 4.29.79h.01c6.63 0 12.01-5.38 12.01-12.01C28.03 8.38 22.65 3 16.01 3Zm0 21.8h-.01a9.8 9.8 0 0 1-5-1.37l-.36-.21-4.58 1.1 1.13-4.47-.24-.37a9.77 9.77 0 0 1-1.51-5.28c0-5.42 4.42-9.83 9.84-9.83 2.63 0 5.1 1.03 6.96 2.88a9.77 9.77 0 0 1 2.87 6.96c0 5.42-4.42 9.83-9.84 9.83h-.01Zm5.4-7.36c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.66.15-.2.3-.76.96-.94 1.16-.17.2-.34.22-.64.07-.3-.15-1.25-.46-2.38-1.47a8.9 8.9 0 0 1-1.65-2.05c-.17-.3-.02-.46.13-.6.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.66-1.6-.91-2.19-.24-.58-.48-.5-.66-.5h-.56c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.87 1.22 3.07.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.62.71.23 1.36.2 1.87.12.57-.08 1.75-.71 2-1.4.25-.68.25-1.27.17-1.4-.07-.12-.27-.2-.57-.34Z"/></svg>
</a>
<div class="whatsapp-tooltip">Chat with us on WhatsApp</div>

<div class="cookie-banner" data-cookie-banner>
  <p>We use a small number of cookies to understand how visitors use this site. No personal data is sold or shared. See our <a href="/cookie-policy.html">Cookie Policy</a> for details.</p>
  <div class="cookie-actions">
    <button class="btn btn-primary btn-sm" data-cookie-accept>Accept</button>
    <button class="btn btn-secondary btn-sm" data-cookie-decline>Decline</button>
  </div>
</div>

<script src="/js/main.js"></script>
</body>
</html>
